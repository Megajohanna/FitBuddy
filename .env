# FitBuddy Application Configuration
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=fitbuddy-secret-key-change-in-production

# Google Gemini API Key
# Get your API key at: https://aistudio.google.com/app/apikey
# If empty, FitBuddy automatically operates using its built-in smart fitness engine!
GEMINI_API_KEY=

# Server Port and Host
PORT=5000
HOST=127.0.0.1
